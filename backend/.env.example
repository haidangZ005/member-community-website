NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:password@localhost:5432/member_community_db
DATABASE_SSL=false
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_another_32_random_characters
JWT_REFRESH_EXPIRES_IN=7d
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Member Community <no-reply@membercommunity.local>"
CLIENT_URL=http://localhost:5173

